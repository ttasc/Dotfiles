#!/bin/sh
#
# filetypes="$*"
#
# [ -z "$filetypes" ] && exit 0
#
# fts="$1"
#
# for type in $filetypes; do
#     if [ "$type" = "$fts" ]; then continue; fi
#     fts="$fts|$type"
# done
#
# find . -type f -regextype posix-egrep -regex ".+\.($fts)" | grep -v libs | sed 's/.*/"&"/' | xargs wc -l

filetypes="$*"

[ -z "$filetypes" ] && exit 0

fts="$1"

for type in $filetypes; do
    if [ "$type" = "$fts" ]; then continue; fi
    fts="$fts|$type"
done

# Tìm file -> Bỏ qua thư mục libs -> Đọc nội dung file -> Loại bỏ comment và dòng trống -> Đếm dòng
find . -type f -regextype posix-egrep -regex ".+\.($fts)" \
    | grep -v libs \
    | sed 's/.*/"&"/' \
    | xargs cat \
    | grep -vE '^\s*(//|#|/\*|\*|<!--)' \
    | grep -vE '^\s*$' \
    | wc -l
